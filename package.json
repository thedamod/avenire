{
  "name": "@avenire/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @avenire/web dev",
    "dev:web": "vp run --filter @avenire/web dev",
    "dev:desktop": "vp run --filter @avenire/desktop dev",
    "dev:mobile": "vp run --filter @avenire/mobile dev",
    "email:preview": "vp run --filter @avenire/emailer preview",
    "build": "vp run --filter './apps/*' build",
    "typecheck": "vp run -r --concurrency-limit 4 typecheck",
    "test": "vp run -r test",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "db:generate": "vp run --filter @avenire/database db:generate",
    "db:migrate": "vp run --filter @avenire/database db:migrate",
    "bench:retrieval": "vp run --filter @avenire/retrieval-benchmark bench",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/.next apps/*/dist-electron",
    "test:dependencies": "node --test --test-concurrency=1 patches/security-regressions.test.cjs"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.13.1"
  },
  "packageManager": "pnpm@11.17.0"
}
