# Database (Postgres + pgvector)
DATABASE_URL=postgres://avenire:avenire@localhost:5432/avenirev2

# Auth (better-auth)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
OPENROUTER_API_KEY=
# Optional model overrides for the ruth-* registry (packages/ai/src/models)
# RUTH_MODEL_SPRINT=anthropic/claude-haiku-4.5
# RUTH_MODEL_CORE=anthropic/claude-sonnet-5.5
# RUTH_MODEL_APEX=anthropic/claude-opus-5.5
OPENAI_API_KEY=
# HMAC secret that signs Ruth's tool approval requests so clients cannot forge approvals
RUTH_APPROVAL_SECRET=change-me

# Cloud sandboxes (Daytona)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Storage (files-sdk, S3-compatible)
FILES_SDK_PROVIDER=r2
STORAGE_BUCKET=avenire
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM="Avenire <hello@avenire.space>"

# Observability (PostHog)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Widget-only origin; locally use widgets.localhost on the same Next server port
WIDGET_ORIGIN=http://widgets.localhost:3000
# HMAC secret for short-lived widget URLs
WIDGET_SIGNING_SECRET=change-me
# Optional dedicated asset HMAC secret; blank falls back to WIDGET_SIGNING_SECRET
ASSET_SIGNING_SECRET=
# Comma-separated app origins permitted to embed widgets
APP_ORIGINS=http://localhost:3000
# Public app URL used for permanent authenticated asset links
APP_URL=http://localhost:3000
# Chat snapshot selected by @avenire/cloud/snapshots; Python 3.13, Playwright/Chromium,
# scientific tools and manimgx are built into the image.
# Optional package-index network allow list; blank keeps chat sandbox networking blocked
# CHAT_SANDBOX_NETWORK_ALLOW_LIST=
# Per-user daily chat sandbox wall-clock quota in seconds
CHAT_SANDBOX_DAILY_SECONDS=3600

# Persistent Ruth Cloud: the API hostname scopes the per-user Daytona run-token secret.
# Required by CloudBoxesLive; replace with the API/tunnel URL and model/API IPv4 CIDRs.
RUTH_CLOUD_API_BASE_URL=https://api.example.com
RUTH_CLOUD_EGRESS_CIDRS=
# Organization secret must already exist and be scoped to the model provider's hosts.
# RUTH_CLOUD_MODEL_SECRET=ruth-cloud-model-key
# Build avenireRuthCloudImage with CLOUD_LIMITS.resources before using this snapshot.
# DAYTONA_RUTH_CLOUD_SNAPSHOT=avenire-ruth-cloud

# Pi model id for Ruth Cloud; the model key stays in the Daytona organization secret.
# RUTH_CLOUD_PI_MODEL=anthropic/claude-opus-5.5
# Global Cloud executor concurrency (each user workspace executes one run at a time).
RUTH_CLOUD_CONCURRENCY=2

# Optional screenshot transport override per registry slot; vision is discovered from OpenRouter
# RUTH_MODEL_CORE_TOOL_RESULT_IMAGES=false
# RUTH_MODEL_CORE_VISION=true
RUTH_MODEL_MAX_IMAGES=3
