# Database (Postgres + pgvector)
DATABASE_URL=postgres://avenire:avenire@localhost:5432/avenirev2

# Auth (better-auth)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
# Ruth models are wired in packages/ai/src/models: sprint on Fireworks, core/apex on OpenRouter
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=
# HMAC secret that signs Ruth's tool approval requests so clients cannot forge approvals
RUTH_APPROVAL_SECRET=change-me

# Cloud sandboxes (Daytona)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Storage (files-sdk, S3-compatible)
FILES_SDK_PROVIDER=r2
STORAGE_BUCKET=avenire
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM="Avenire <hello@avenire.space>"

# Observability (PostHog)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Mobile (Expo) only: where the phone reaches the web server. Leave blank on a simulator;
# in dev it falls back to the host Metro is served from. Over Tailscale use the laptop's
# Tailnet IP or MagicDNS name, and start Metro with REACT_NATIVE_PACKAGER_HOSTNAME set to it too.
# EXPO_PUBLIC_API_URL=http://100.x.y.z:3000

# Extra comma-separated origins better-auth should trust. Expo Go sends exp://<metro-host>:8081/--/
# (a dev build sends avenire://, already trusted); `next start` is production, so list it here.
# AUTH_TRUSTED_ORIGINS=exp://100.*.*.*:*/**
#
# Mobile over Tailscale also loads web pages (PDF citations) and signed asset/widget URLs from the
# phone, so every server-side origin must be the one the phone reaches, not localhost:
# BETTER_AUTH_URL, APP_URL and APP_ORIGINS=http://100.x.y.z:3000, and add that origin to
# AUTH_TRUSTED_ORIGINS (e.g. AUTH_TRUSTED_ORIGINS=http://100.x.y.z:3000,exp://100.*.*.*:*/**).
# Otherwise the in-app PDF viewer is sent to sign-in and widget/file URLs point at localhost.
# APP_URL builds the /a/<token> links widgets are loaded from. WIDGET_ORIGIN must stay a different
# host than the app (the server rejects app paths on it): if the app uses the MagicDNS name, give
# WIDGET_ORIGIN the same machine's Tailnet IP (or the reverse).

# Widget-only origin; use localhost for the app and 127.0.0.1 on the same Next server port
WIDGET_ORIGIN=http://127.0.0.1:3000
# HMAC secret for short-lived widget URLs
WIDGET_SIGNING_SECRET=change-me
# Optional dedicated asset HMAC secret; blank falls back to WIDGET_SIGNING_SECRET
ASSET_SIGNING_SECRET=
# Comma-separated app origins permitted to embed widgets
APP_ORIGINS=http://localhost:3000
# Public app URL used for permanent authenticated asset links
APP_URL=http://localhost:3000
# Chat snapshot selected by @avenire/cloud/snapshots; Python 3.13, Playwright/Chromium,
# scientific tools and manimgx are built into the image.
# Optional package-index network allow list; blank keeps chat sandbox networking blocked
# CHAT_SANDBOX_NETWORK_ALLOW_LIST=
# Per-user daily chat sandbox wall-clock quota in seconds
CHAT_SANDBOX_DAILY_SECONDS=3600

# Persistent Ruth Cloud uses server OpenRouter credentials and the shared v4 snapshot.
# Task models are registry names; network defaults to package indexes only.
# RUTH_CLOUD_MAX_COST_USD=5
RUTH_CLOUD_CONCURRENCY=2
