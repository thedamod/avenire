# Database (Postgres + pgvector)
DATABASE_URL=postgres://avenire:avenire@localhost:5432/avenire

# Auth (better-auth)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
ANTHROPIC_API_KEY=
# Optional model overrides for the ruth-* registry (packages/ai/src/models)
# RUTH_MODEL_SPRINT=claude-haiku-4-5-20251001
# RUTH_MODEL_CORE=claude-sonnet-5-5
# RUTH_MODEL_APEX=claude-opus-5-5
# RUTH_MODEL_AGENT=claude-opus-5-5
OPENAI_API_KEY=
# HMAC secret that signs Ruth's tool approval requests so clients cannot forge approvals
RUTH_APPROVAL_SECRET=change-me

# Cloud sandboxes (Daytona)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Storage (files-sdk, S3-compatible)
FILES_SDK_PROVIDER=r2
STORAGE_BUCKET=avenire
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM="Avenire <hello@avenire.space>"

# Observability (PostHog)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Widget-only origin; locally use widgets.localhost on the same Next server port
WIDGET_ORIGIN=http://widgets.localhost:3000
# HMAC secret for permanent widget capability URLs
WIDGET_SIGNING_SECRET=change-me
# Optional dedicated artifact HMAC secret; blank falls back to WIDGET_SIGNING_SECRET
ARTIFACT_SIGNING_SECRET=
# Comma-separated app origins permitted to embed widgets
APP_ORIGINS=http://localhost:3000
# Public app URL used for signed seven-day artifact downloads
APP_URL=http://localhost:3000
# Chat snapshot with Python 3.12, scientific stack, Manim, ffmpeg and LaTeX preinstalled
# DAYTONA_CHAT_SNAPSHOT=ruth-chat-python312
# Optional package-index network allow list; blank keeps chat sandbox networking blocked
# CHAT_SANDBOX_NETWORK_ALLOW_LIST=
# Per-user daily chat sandbox wall-clock quota in seconds
CHAT_SANDBOX_DAILY_SECONDS=3600
