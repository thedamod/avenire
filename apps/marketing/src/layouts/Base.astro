---
import "../styles/marketing.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Avenire" />
    <meta property="og:image" content="https://avenire.space/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Avenire: your study material, organized and brought to you" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://avenire.space/og.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      // Opt in to motion only when the reveal script below can run; otherwise nothing hides.
      if ("IntersectionObserver" in window) document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      // Float each [data-reveal] element in once, the first time it enters the viewport.
      // Elements arriving in the same batch stagger by 70ms (Emil: 30–80ms).
      (() => {
        if (!("IntersectionObserver" in window)) return;
        const observer = new IntersectionObserver(
          (entries) => {
            let index = 0;
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const element = entry.target;
              element.style.transitionDelay = `${Math.min(index++, 8) * 70}ms`;
              element.setAttribute("data-revealed", "");
              observer.unobserve(element);
            }
          },
          { rootMargin: "0% 0% -8% 0%" },
        );
        for (const element of document.querySelectorAll("[data-reveal]")) observer.observe(element);
      })();
    </script>
  </body>
</html>
