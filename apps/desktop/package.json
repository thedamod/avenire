{
  "name": "@avenire/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/boot.cjs",
  "exports": {
    "./bridge": {
      "types": "./src/bridge.ts",
      "import": "./src/bridge.ts"
    },
    "./source-acquisition": {
      "types": "./src/capture/source-acquisition.ts",
      "import": "./src/capture/source-acquisition.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "dist": "node scripts/native-build.mjs && node scripts/build.mjs && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "test": "pnpm capture:behavior && node scripts/native-overlay-behavior.mjs",
    "native:behavior": "node scripts/native-overlay-behavior.mjs",
    "native:build": "node scripts/native-build.mjs",
    "capture:behavior": "pnpm -w exec vp test run --config vite.config.ts apps/desktop/src/capture/pipeline.test.ts apps/desktop/src/capture/source-acquisition.test.ts apps/desktop/src/capture/download-validation.test.ts apps/desktop/src/capture/collectors/linux-mac-collectors.test.ts"
  },
  "dependencies": {
    "@avenire/capture": "workspace:*",
    "@avenire/contracts": "workspace:*",
    "@avenire/storage": "workspace:*",
    "effect": "catalog:",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "8.18.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "vite-plus": "catalog:"
  }
}
