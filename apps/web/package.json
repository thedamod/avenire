{
  "name": "@avenire/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @avenire/widget-kit build && next dev --turbopack",
    "build": "pnpm --filter @avenire/widget-kit build && next build",
    "start": "next start --keepAliveTimeout 65000",
    "worker": "tsx watch --env-file-if-exists=../../.env.local src/server/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @avenire/widget-kit build && vp test run --config ../../vite.config.ts --dir . --passWithNoTests",
    "ruth:prompt": "tsx --env-file-if-exists=../../.env.local scripts/ruth-prompt.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env.local scripts/seed-demo-library.ts",
    "cloud:check": "tsx --env-file-if-exists=../../.env.local scripts/cloud-check.ts"
  },
