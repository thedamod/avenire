{
  "name": "@avenire/retrieval-benchmark",
  "private": true,
  "type": "module",
  "exports": {
    "./metrics": {
      "types": "./src/metrics.ts",
      "import": "./src/metrics.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir . --passWithNoTests",
    "bench": "tsx --env-file-if-exists=../../.env.local src/bin.ts",
    "bench:v1": "tsx --env-file-if-exists=../../.env.local src/v1/bin.ts",
    "bench:calibrate": "tsx --env-file-if-exists=../../.env.local src/v1/calibrate-bin.ts",
    "bench:summary": "tsx --env-file-if-exists=../../.env.local src/v1/summary-final-bin.ts",
    "corpus:fetch": "tsx --env-file-if-exists=../../.env.local src/v1/corpus-bin.ts fetch",
    "corpus:import-local": "tsx --env-file-if-exists=../../.env.local src/v1/corpus-bin.ts import-local",
    "corpus:import-mit": "tsx --env-file-if-exists=../../.env.local src/v1/corpus-bin.ts import-mit",
    "corpus:status": "tsx --env-file-if-exists=../../.env.local src/v1/corpus-bin.ts status"
  },
  "dependencies": {
    "@avenire/contracts": "workspace:*",
    "@avenire/database": "workspace:*",
    "@avenire/ingestion": "workspace:*",
    "@effect/platform-node": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "tsx": "4.23.15",
    "vite-plus": "catalog:"
  }
}
