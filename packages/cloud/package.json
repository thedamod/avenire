{
  "name": "@avenire/cloud",
  "private": true,
  "type": "module",
  "exports": {
    "./daytona": {
      "types": "./src/daytona.ts",
      "import": "./src/daytona.ts"
    },
    "./chat-sandbox": {
      "types": "./src/chatSandbox.ts",
      "import": "./src/chatSandbox.ts"
    },
    "./snapshots": {
      "types": "./src/snapshots.ts",
      "import": "./src/snapshots.ts"
    },
    "./cloud-box": {
      "types": "./src/cloudBox.ts",
      "import": "./src/cloudBox.ts"
    },
    "./screen": {
      "types": "./src/screen.ts",
      "import": "./src/screen.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir . --passWithNoTests",
    "snapshot:build": "tsx --env-file-if-exists=../../.env.local scripts/build-snapshot.ts",
    "snapshot:verify": "tsx --env-file-if-exists=../../.env.local scripts/verify-snapshot.ts"
  },
  "dependencies": {
    "@avenire/contracts": "workspace:*",
    "@daytonaio/sdk": "0.220.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
