{
  "name": "@avenire/database",
  "private": true,
  "type": "module",
  "exports": {
    "./corpus": {
      "types": "./src/corpus.ts",
      "import": "./src/corpus.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir . --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@avenire/contracts": "workspace:*",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "vite-plus": "catalog:"
  }
}
