      "web.telegram.org",
      "teams.microsoft.com",
      "messages.google.com",
      "messenger.com",
      "slack.com"
    ]
  },
  {
    "category": "messaging",
    "patterns": ["^https?://(?:[^/]+\\.)?discord\\.com/channels(?:[/?#]|$)"]
  },
  {
